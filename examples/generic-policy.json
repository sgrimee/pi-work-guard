{
  "$schema": "https://raw.githubusercontent.com/pi-coding-agent/pi-work-guard/main/schema.json",
  "company": {
    "name": "Acme Corporation",
    "emailDomains": [
      "acme.corp",
      "acme.com"
    ],
    "remotePatterns": [
      "*acme.corp*",
      "github.com/acme-corp/*",
      "gitlab.acme.corp/*"
    ],
    "localPathPatterns": [
      "~/work/**",
      "~/acme/**"
    ]
  },
  "workPolicy": {
    "defaultBehavior": "deny",
    "fallbackModel": "github-copilot/gpt-5.4",
    "autoSwitchToFallback": false,
    "providers": {
      "github-copilot": {
        "mode": "require_account",
        "allowedEmailDomains": [
          "acme.corp",
          "acme.com"
        ],
        "allowEnterpriseSKU": true
      },
      "openai-codex": {
        "mode": "require_account",
        "allowedEmailDomains": [
          "acme.corp",
          "acme.com"
        ]
      },
      "anthropic": {
        "mode": "allow_if_tagged",
        "allowedEmailDomains": [
          "acme.corp",
          "acme.com"
        ],
        "deniedAccounts": [
          "*@gmail.com",
          "*@yahoo.com"
        ]
      },
      "azure-openai": {
        "mode": "allow"
      },
      "amazon-bedrock": {
        "mode": "allow"
      },
      "opencode": {
        "mode": "deny",
        "reason": "The 'OpenCode Zen' provider is not approved for corporate repositories."
      },
      "openrouter": {
        "mode": "deny",
        "reason": "OpenRouter is prohibited on corporate repositories."
      }
    }
  },
  "personalPolicy": {
    "defaultBehavior": "allow"
  }
}