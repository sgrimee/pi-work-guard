{
  "$schema": "https://raw.githubusercontent.com/pi-coding-agent/pi-work-guard/main/schema.json",
  "company": {
    "name": "Acme Corporation",
    "emailDomains": [
      "acme.corp"
    ],
    "remotePatterns": [
      "*acme.corp*",
      "github.com/acme-corp/*"
    ],
    "localPathPatterns": [
      "*acme*"
    ]
  },
  "workPolicy": {
    "defaultBehavior": "deny",
    "fallbackModel": "github-copilot/gpt-5.6-terra",
    "autoSwitchToFallback": false,
    "providers": {
      "github-copilot": {
        "mode": "require_account",
        "allowedEmailDomains": [
          "acme.corp"
        ],
        "allowEnterpriseSKU": true
      },
      "openai-codex": {
        "mode": "require_account",
        "allowedEmailDomains": [
          "acme.corp"
        ]
      },
      "anthropic": {
        "mode": "allow_if_tagged",
        "allowedEmailDomains": [
          "acme.corp"
        ]
      },
      "azure-openai": {
        "mode": "deny"
      },
      "amazon-bedrock": {
        "mode": "deny"
      },
      "opencode": {
        "mode": "deny",
        "reason": "The 'OpenCode Zen' provider is not approved by Acme Corporation policy for proprietary repositories."
      },
      "openrouter": {
        "mode": "deny",
        "reason": "OpenRouter external routing is prohibited on Acme Corporation proprietary repositories."
      }
    }
  },
  "personalPolicy": {
    "defaultBehavior": "allow"
  }
}
